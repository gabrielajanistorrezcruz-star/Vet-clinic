# Clave privada de OpenRouter. No la compartas ni la subas al repositorio.
OPENROUTER_API_KEY=tu_clave_aqui

# Modelo disponible en OpenRouter. Puedes cambiarlo sin tocar el código.
OPENROUTER_MODEL=openai/gpt-4o-mini

# URL pública del sitio (opcional, se usa en las cabeceras de OpenRouter).
SITE_URL=http://localhost:3000

# Orígenes adicionales permitidos por CORS, separados por comas (opcional).
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Puerto del servidor (opcional).
PORT=3000
